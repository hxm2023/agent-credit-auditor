{
  "protocol_id": "m0_regression_v1",
  "protocol_version": "v1",
  "description": "M0-style target audit, docs_only_semantic mode. Pre-registered target-identity, independent-oracle, and sampling-support gates over designed BernoulliSequenceMDP cases. All numbers new; legacy 144/202 etc. are historical background only.",
  "reconstruction_mode": "docs_only_semantic",
  "frozen_at": "2026-08-22",
  "world_family": "bernoulli_sequence_mdp",
  "policy_parameterization": "independent_logits",
  "reward_semantics": "terminal",
  "horizon_range": [2, 4, 6],
  "problem_seed_prefix": "ACA-SEM-M0",
  "problem_seed_count": 12,
  "primary_estimand": "full_score_gradient",
  "tolerances": {
    "oracle_mismatch_rel": 1e-9,
    "oracle_mismatch_abs": 1e-12,
    "bias_rel": 1e-9,
    "bias_abs": 1e-12,
    "near_zero_target_abs": 1e-8
  },
  "estimators": ["dense", "local_sibling", "propagated_sibling", "uniform_hh", "bpo_like"],
  "sampling_spec": {
    "replacement": "with_replacement",
    "minimum_support": 1e-6,
    "hh_correction": "hansen_hurwitz",
    "restore_state_identity": "exact"
  },
  "designed_cases": [
    {
      "case_id": "bpo_prefix_propagation",
      "estimand_claimed": "full_score_gradient",
      "expected": {"propagated_sibling": "T003_LOCAL_TO_PREFIX_PROPAGATION", "bpo_like": "T002_BIAS_EXCEEDS_TOLERANCE"},
      "note": "Local contrast at a leaf propagated to already-shared prefix actions must not equal the full gradient."
    },
    {
      "case_id": "shared_logit_predictable_width",
      "estimand_claimed": "root_marginal_gradient",
      "expected": {"local_sibling": "T002_BIAS_EXCEEDS_TOLERANCE"},
      "note": "Root-marginal under shared logit is not a flat leaf average."
    },
    {
      "case_id": "outcome_retention",
      "estimand_claimed": "full_score_gradient",
      "expected": {"bpo_like": "T005_CLIPPING_SCOPE_MISMATCH"},
      "note": "Retaining only a subset of outcomes changes the target; a clipped/partial-score estimator must not be reported as full gradient."
    },
    {
      "case_id": "completion_deadline",
      "estimand_claimed": "full_score_gradient",
      "expected": {"local_sibling": "T004_CONTINUATION_TARGET_MISMATCH"},
      "note": "Continuation under a different policy/length than the target changes the estimand."
    },
    {
      "case_id": "matched_cost_positive",
      "estimand_claimed": "full_score_gradient",
      "expected": {"uniform_hh": "PASS", "dense": "PASS"},
      "note": "Narrow positive control: some branching estimator must win under matched fixed budget on a designed case, proving the Auditor can approve narrow-domain positives."
    }
  ],
  "gates": {
    "target_identity": {"required": true, "reason_codes": ["T001_ESTIMAND_UNSPECIFIED", "T002_BIAS_EXCEEDS_TOLERANCE", "T003_LOCAL_TO_PREFIX_PROPAGATION", "T004_CONTINUATION_TARGET_MISMATCH", "T005_CLIPPING_SCOPE_MISMATCH"]},
    "independent_oracle": {"required": true, "reason_codes": ["E002_ORACLE_MISMATCH"]},
    "sampling_support": {"required": true, "reason_codes": ["S001_ZERO_SUPPORT", "S002_Q_NOT_LOGGED", "S003_WRONG_HH_HT_CORRECTION", "S004_OUTCOME_ADAPTIVE_UNDECLARED"]}
  },
  "fault_injection_expected": {
    "A1": "T002_BIAS_EXCEEDS_TOLERANCE",
    "A2": "T003_LOCAL_TO_PREFIX_PROPAGATION",
    "A3": "S001_ZERO_SUPPORT",
    "A4": "S003_WRONG_HH_HT_CORRECTION"
  }
}
