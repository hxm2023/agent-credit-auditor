    classDef world fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef est fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef ora fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef gate fill:#f3e8ff,stroke:#9333ea,color:#581c87
    classDef ev fill:#f1f5f9,stroke:#475569,color:#0f172a

    class P,S input
    class R1,R2 run
    class W1,W2,W3,W4,W5 world
    class E1,E2,E3,E4,E5 est
    class O1,O2,O3,O4 ora
    class G1,G2,G3,G4,G5 gate
    class A1,A2,A3,A4,A5,A6,A7 ev
